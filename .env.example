# Copia este archivo a .env y completa los valores. No subas secretos.

# Cadena de conexión de Neon/PostgreSQL.
DATABASE_URL=

# Ya no se usa DEV_USER_ID: el usuario actual sale de la sesión (login).
# Para poner la contraseña del primer administrador:
#   node --env-file=.env --import tsx scripts/set-password.mts <correo> <contraseña>
