# Copia este archivo a .env y completa los valores. No subas secretos.

# Cadena de conexión de Neon/PostgreSQL.
DATABASE_URL=

# Ya no se usa DEV_USER_ID: el usuario actual sale de la sesión (login).
# Para poner la contraseña del primer administrador:
#   node --env-file=.env --import tsx scripts/set-password.mts <correo> <contraseña>

# Contacto comercial de la página de venta (opcionales).
# WhatsApp en formato internacional sin "+" (p. ej. 56912345678). Si falta,
# los botones de los planes usan el correo; si faltan ambos, llevan al login.
CONTACT_WHATSAPP=
CONTACT_EMAIL=

# Envío de correos (Resend). Crea la API key en https://resend.com/api-keys.
# EMAIL_FROM debe ser de un dominio verificado en Resend (p. ej.
# cotizaciones@tudominio.cl). Cada correo sale con el NOMBRE de la empresa como
# remitente y Reply-To al correo de la empresa. Para pruebas sin dominio usa
# onboarding@resend.dev (solo entrega a tu propio correo de Resend).
RESEND_API_KEY=
EMAIL_FROM=
